<Project>
  <PropertyGroup>
    <!-- Sync these fields from the read-only Gateway checkout with scripts/bump-build.ps1. -->
    <GatewayVersion>2026.11.8</GatewayVersion>
    <GatewaySourceVersion>2026.11.8</GatewaySourceVersion>
    <GatewaySourceCommit>92d4728c1f9be71cd96918619d3777368bbda257</GatewaySourceCommit>
    <GatewaySyncDate>2026-11-24</GatewaySyncDate>
    <CompanionRevision>0</CompanionRevision>
    <GatewayNumericVersion>$([System.Text.RegularExpressions.Regex]::Match('$(GatewayVersion)', '^\d+\.\d+\.\d+').Value)</GatewayNumericVersion>
    <Version>$(GatewayVersion)</Version>
    <AssemblyVersion>$(GatewayNumericVersion).0</AssemblyVersion>
    <FileVersion>$(GatewayNumericVersion).$(CompanionRevision)</FileVersion>
    <InformationalVersion>$(GatewayVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="GatewayVersion" Value="$(GatewayVersion)" />
    <AssemblyMetadata Include="GatewaySourceVersion" Value="$(GatewaySourceVersion)" />
    <AssemblyMetadata Include="GatewaySourceCommit" Value="$(GatewaySourceCommit)" />
    <AssemblyMetadata Include="GatewaySyncDate" Value="$(GatewaySyncDate)" />
    <AssemblyMetadata Include="CompanionRevision" Value="$(CompanionRevision)" />
  </ItemGroup>
</Project>
